// Cmail — Cloudflare Workers configuration
// deploy.sh fills <D1_ID> automatically during installation.
//
// NOTE: there is intentionally NO "assets" block here. The worker embeds
// every UI file inside itself (scripts/build-worker.mjs), so the whole app
// is ONE file: paste worker.js in the dashboard editor, add a single D1
// binding named DB, done.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmail",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,

  "vars": {
    "APP_VERSION": "2.5.0"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cmail-db",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ],

  "triggers": {
    // hourly cleanup: expire temporary addresses & purge old mail
    "crons": ["17 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
